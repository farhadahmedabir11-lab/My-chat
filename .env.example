# GEMINI_API_KEY: Required only if Gemini AI API calls are added later.
# GEMINI_API_KEY=MY_GEMINI_API_KEY

# Optional Free-Tier WebRTC TURN / Signaling Secrets (Metered Open Relay 20 GB/mo free tier).
# Configure real values in the AI Studio Secrets panel (never commit real secrets to git).
# If left at placeholder values, My Chat still supports WebRTC calls over free Google STUN servers.
METERED_APP_DOMAIN=MY_METERED_APP_DOMAIN
METERED_API_KEY=MY_METERED_API_KEY
METERED_REALTIME_API_KEY=MY_METERED_REALTIME_API_KEY

# Optional standalone free TURN server fallback (e.g., Metered static TURN URI + credentials)
TURN_SERVER_URL=MY_TURN_SERVER_URL
TURN_USERNAME=MY_TURN_USERNAME
TURN_CREDENTIAL=MY_TURN_CREDENTIAL
